<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:orientation="vertical">

    <!-- Bulle Utilisateur (à droite, fond violet) -->
    <LinearLayout
        android:id="@+id/layoutUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:background="@drawable/bg_chat_user"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Bulle Assistant IA (à gauche, fond verre) -->
    <LinearLayout
        android:id="@+id/layoutAssistantMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_chat_assistant"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAssistantContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
