<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme : Material3 Dark NoActionBar -->
    <style name="Base.Theme.ClubSync" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSurface">@color/card_glass_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.ClubSync" parent="Base.Theme.ClubSync" />

    <!-- Style Bouton Primaire Violet -->
    <style name="Widget.ClubSync.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Style Champ de saisie Glass/Dark -->
    <style name="Widget.ClubSync.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="hintTextColor">@color/input_hint</item>
        <item name="android:textColorHint">@color/input_hint</item>
    </style>
</resources>
