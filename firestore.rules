rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vérifie si l'utilisateur connecté possède le rôle ADMIN
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Récupère le memberId associé à l'utilisateur connecté
    function getUserMemberId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId;
    }

    // 1. Collection users
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // 2. Collection members
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 3. Collection events
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      // Mise à jour : Admin complet OU incrément/décrément de registeredCount lors d'une inscription
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) &&
        (request.resource.data.registeredCount == resource.data.registeredCount + 1 ||
         request.resource.data.registeredCount == resource.data.registeredCount - 1)
      );
    }

    // 4. Collection registrations
    match /registrations/{regId} {
      allow read: if request.auth != null;
      // Un membre ne peut créer ou supprimer que sa propre inscription
      allow create: if request.auth != null && (
        isAdmin() ||
        request.resource.data.memberId == getUserMemberId() ||
        request.resource.data.memberId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.memberId == getUserMemberId() ||
        resource.data.memberId == request.auth.uid
      );
    }

    // 5. Collection attendances
    match /attendances/{attId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
